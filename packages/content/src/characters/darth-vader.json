    {
      "id": "darth-vader-inner-conflict",
      "name": "Inner Conflict",
      "category": "versatile",
      "usableBy": "MAIN",
      "value": 2,
      "boost": 1,
      "count": 3,
      "description": "After combat: If you won the combat, your opponent chooses whether you both draw a card or both discard a card.\nIf you lost the combat, you make that choice instead.",
