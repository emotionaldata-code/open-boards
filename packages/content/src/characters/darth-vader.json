              "type": "choose-fighter",
              "relation": "any",
              "range": "zone",
              "effects": [
                {
                  "type": "damage",
                  "target": "chosen",
                  "amount": {
                    "card": "selected",
                    "field": "boost"
                  }
                }
              ]
            }
          ]
        }
      ],
      "when": {
        "type": "compare",
        "left": {
          "stat": "hand"
        },
        "op": "gt",
        "right": 0
      }
    }
  ],
