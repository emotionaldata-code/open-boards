          "description": "If you won the combat, your opponent chooses whether you both draw a card or both discard a card.\nIf you lost the combat, you make that choice instead.",
          "trigger": "after-combat",
          "effects": [
            {
              "type": "if",
              "condition": {
                "type": "combat-result",
                "result": "won"
              },
              "then": [
                {
                  "type": "choose-option",
                  "chooser": "opponent",
                  "prompt": "Inner Conflict \u00b7 choose for both players",
                  "options": [
                    {
                      "id": "draw",
                      "label": "Both draw 1 card",
                      "effects": [
                        {
                          "type": "draw",
                          "count": 1
                        },
                        {
                          "type": "draw",
                          "target": "opponent",
                          "count": 1
                        }
                      ]
                    },
                    {
                      "id": "discard",
                      "label": "Both discard 1 card",
                      "effects": [
                        {
                          "type": "discard",
                          "count": 1
                        },
                        {
                          "type": "discard",
                          "target": "opponent",
                          "count": 1
                        }
                      ]
                    }
                  ]
                }
              ],
              "else": [
                {
                  "type": "choose-option",
                  "prompt": "Inner Conflict \u00b7 choose for both players",
                  "options": [
                    {
                      "id": "draw",
                      "label": "Both draw 1 card",
                      "effects": [
                        {
                          "type": "draw",
                          "count": 1
                        },
                        {
                          "type": "draw",
                          "target": "opponent",
                          "count": 1
                        }
                      ]
                    },
                    {
                      "id": "discard",
                      "label": "Both discard 1 card",
                      "effects": [
                        {
                          "type": "discard",
                          "count": 1
                        },
                        {
                          "type": "discard",
                          "target": "opponent",
                          "count": 1
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
